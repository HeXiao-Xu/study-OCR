# ===== Python =====
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ===== 密钥与环境变量（绝不提交）=====
.env
.env.*
!.env.example
# 前端 env 是非机密配置（构建需要，会被打进产物），放行入库
!web/.env.development
!web/.env.production
!web/.env.example

# 私钥仓（S4-5 起使用）：口令加密的 PKCS#8 与证书私钥一律不入库
secrets/
*.pem
*.key
*.p12
*.pfx
!deploy/certs/README.md

# ===== 票据样本（含个人信息风险，绝不入库）=====
# 只允许 MANIFEST.md 与生成脚本入库，图片/PDF 一律本地
samples/*
!samples/.gitkeep
!samples/MANIFEST.md
!samples/README.md

# ===== 评测生成物（结果按时间戳命名，不入库）=====
backend/eval/results/*
# 基线的 Markdown 报告是论文素材，要入库（原始 JSON 仍不入库）
!backend/eval/results/baseline_report.md
!backend/eval/results/.gitkeep
!backend/eval/results/README.md
backend/eval/datasets/*.png
backend/eval/datasets/*.jpg
backend/eval/datasets/*.pdf

# ===== Node / 前端 =====
node_modules/
dist/
*.local

# ===== IDE =====
.idea/
.vscode/

# ===== 系统文件 =====
.DS_Store
Thumbs.db
desktop.ini

# ===== 日志与临时文件 =====
*.log
logs/
tmp/
temp/

# ===== 模型与缓存（首次运行自动下载，体积大）=====
.paddleocr/
**/model_cache/
jieba.cache