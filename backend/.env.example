# =====================================================================
# 后端配置示例（复制为 backend/.env 后按需修改）
#   cp backend/.env.example backend/.env
# 真实 .env 不入库（见 .gitignore）。
# 连接地址要与 deploy/.env 保持一致：本机端口已错开为 5433 / 6380 / 9002。
# =====================================================================

# ---------- 应用 ----------
APP_NAME=study-ocr
APP_VERSION=0.1.0
# dev / test / prod：prod 会拒绝示例 JWT_SECRET
ENVIRONMENT=dev
LOG_LEVEL=INFO
API_PREFIX=/api/v1
# 逗号分隔或 JSON 数组；前端开发服务器默认 5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- PostgreSQL ----------
DATABASE_URL=postgresql://studyocr:change_me_pg_dev@127.0.0.1:5433/studyocr

# ---------- Redis ----------
REDIS_URL=redis://:change_me_redis_dev@127.0.0.1:6380/0

# ---------- MinIO ----------
MINIO_ENDPOINT=127.0.0.1:9002
MINIO_ACCESS_KEY=studyocr
MINIO_SECRET_KEY=change_me_minio_dev
MINIO_BUCKET=study-ocr-invoices
MINIO_SECURE=false

# ---------- 安全 ----------
# 至少 32 字符；生成方式：python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=change_me_jwt_secret_at_least_32_chars_long

# ---------- 业务参数 ----------
# 单文件上传上限（MB），与前端、Nginx client_max_body_size 保持一致（D-018）
MAX_UPLOAD_MB=20

# ---------- OCR（S1-3）----------
# 检测识别参数；S6 做对比实验时可直接改这里
OCR_LANG=ch
OCR_USE_ANGLE_CLS=true
OCR_DET_DB_THRESH=0.3
OCR_DET_DB_BOX_THRESH=0.3
# 票据文本密集，>1.7 相邻行框会粘连导致识别串行
OCR_DET_DB_UNCLIP_RATIO=1.6
# 与 S1-2 的 warp_max_side 对齐；压测可降到 1280 换速度
OCR_DET_LIMIT_SIDE_LEN=1600
OCR_DEVICE=cpu
# 离线机器：把 PP-OCRv4 模型放到本地目录，并在此指定（目录下含 det/ rec/ cls/）
OCR_MODEL_ROOT=
OCR_SHOW_LOG=false

# ---------- OCR 流水线（S3-1）----------
# 协作式 deadline（秒）：必须小于 ARQ job_timeout=180，留出写失败状态的余量
OCR_PIPELINE_DEADLINE_SECONDS=165
# PDF 只识别前 N 页（任务卡"限前 3 页"）
OCR_PDF_MAX_PAGES=3
# worker 并发：PaddleOCR 模型非线程安全，只允许 1 或 2（默认 1）
OCR_WORKER_MAX_JOBS=1

# ---------- 认证（S2-2）----------
# JWT 算法固定 HS256（API.md §0），不提供配置项，避免 alg 混淆
# access 30 分钟、refresh 7 天（秒）
ACCESS_TOKEN_TTL_SECONDS=1800
REFRESH_TOKEN_TTL_SECONDS=604800
# refresh 白名单在 Redis 的 key 前缀：{prefix}:{jti}
REFRESH_TOKEN_PREFIX=auth:refresh
# Argon2id 参数（内存 KiB / 迭代 / 并行度）；登录耗时主要受 memory_cost 影响，取定依据见 D-038
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# ---------- 上传与存储（S2-6）----------
# S4 的 SM4 信封接入前，本地调试允许明文落 MinIO（is_cipher=false）；
# prod 环境必须为 false，否则启动即抛 ConfigError（D-044）
STORAGE_ALLOW_PLAINTEXT=true
# PDF 页数上限（契约 §2 写死 5 页）
UPLOAD_MAX_PDF_PAGES=5

# ---------- 健康检查 ----------
# 单项超时（秒）：任一依赖挂死不能把 /health 拖死
HEALTH_TIMEOUT_S=2.0
# ---------- 定时任务（S2-12）----------
# 每个 API 进程都会启动调度器；任务执行前抢 Redis 锁，保证多副本同一次只跑一遍
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Shanghai
# 审计链锚定：默认每日 02:00（S4-7 才实现逻辑，现在只打日志）
# 双进程验收可临时设为 "*" / "*/10"，完成后恢复
ANCHOR_CRON_HOUR=2
ANCHOR_CRON_MINUTE=0
ANCHOR_CRON_SECOND=0
ANCHOR_LOCK_KEY=scheduler:lock:anchor_audit
ANCHOR_LOCK_TTL_SECONDS=3600
