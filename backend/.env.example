# =====================================================================
# 后端配置示例（复制为 backend/.env 后按需修改）
#   cp backend/.env.example backend/.env
# 真实 .env 不入库（见 .gitignore）。
# 连接地址要与 deploy/.env 保持一致：本机端口已错开为 5433 / 6380 / 9002。
# =====================================================================

# ---------- 应用 ----------
APP_NAME=study-ocr
APP_VERSION=0.1.0
# dev / test / prod：prod 会拒绝示例 JWT_SECRET
ENVIRONMENT=dev
LOG_LEVEL=INFO
API_PREFIX=/api/v1
# 逗号分隔或 JSON 数组；前端开发服务器默认 5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- PostgreSQL ----------
DATABASE_URL=postgresql://studyocr:change_me_pg_dev@127.0.0.1:5433/studyocr

# ---------- Redis ----------
REDIS_URL=redis://:change_me_redis_dev@127.0.0.1:6380/0

# ---------- MinIO ----------
MINIO_ENDPOINT=127.0.0.1:9002
MINIO_ACCESS_KEY=studyocr
MINIO_SECRET_KEY=change_me_minio_dev
MINIO_BUCKET=study-ocr-invoices
MINIO_SECURE=false

# ---------- 安全 ----------
# 至少 32 字符；生成方式：python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=change_me_jwt_secret_at_least_32_chars_long

# ---------- 业务参数 ----------
# 单文件上传上限（MB），与前端、Nginx client_max_body_size 保持一致（D-018）
MAX_UPLOAD_MB=20

# ---------- 健康检查 ----------
# 单项超时（秒）：任一依赖挂死不能把 /health 拖死
HEALTH_TIMEOUT_S=2.0