# =====================================================================
# study-OCR 开发环境基础服务配置（复制为 deploy/.env 后按需修改）
#   cp deploy/.env.example deploy/.env
# deploy/.env 已被 .gitignore 排除，不要把真实口令提交进仓库。
# =====================================================================

# ---------- 宿主机端口 ----------
# 注意：本机若已有别的项目占用 5432/6379/9000/9001（例如 study-agent），
# 这里统一错开，两套环境可以同时跑。
POSTGRES_PORT=5433
REDIS_PORT=6380
MINIO_PORT=9002
MINIO_CONSOLE_PORT=9003

# ---------- PostgreSQL 16 ----------
POSTGRES_USER=studyocr
POSTGRES_PASSWORD=change_me_pg_dev
POSTGRES_DB=studyocr

# ---------- Redis 7 ----------
REDIS_PASSWORD=change_me_redis_dev

# ---------- MinIO ----------
# 口令至少 8 位；bucket 由 minio-init 幂等创建
MINIO_ROOT_USER=studyocr
MINIO_ROOT_PASSWORD=change_me_minio_dev
MINIO_BUCKET=study-ocr-invoices

# ---------- 镜像 ----------
# 拉不到镜像时看 deploy/README.md 的「镜像拉取」一节：直连 Docker Hub 会超时，
# 要用镜像源全名拉取再 docker tag 成标准名（scripts/pull_image.sh 已把这个流程封装好）。
POSTGRES_IMAGE=postgres:16
REDIS_IMAGE=redis:7-alpine
MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest